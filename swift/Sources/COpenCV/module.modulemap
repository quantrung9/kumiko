module COpenCV [system] {
    // OpenCV C++ headers
    // Note: Actual header paths will be resolved via pkg-config at build time
    //
    // Common locations:
    // - macOS (Intel): /usr/local/include/opencv4/
    // - macOS (Apple Silicon): /opt/homebrew/include/opencv4/
    // - Linux (Ubuntu): /usr/include/opencv4/
    //
    // The build system uses pkg-config to find the correct paths automatically

    // Core OpenCV modules needed for Kumiko
    header "/usr/local/include/opencv4/opencv2/core.hpp"
    header "/usr/local/include/opencv4/opencv2/imgproc.hpp"
    header "/usr/local/include/opencv4/opencv2/imgcodecs.hpp"

    // Export all symbols from this module
    export *

    // Link required OpenCV libraries
    link "opencv_core"
    link "opencv_imgproc"
    link "opencv_imgcodecs"
}
